Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<FilesMatch "^\.(env|ini|log|sql|md)$">Require all denied</FilesMatch>
RewriteEngine On
RewriteRule ^(?:config\.local\.php|database\.php|functions\.php|security\.php)$ - [F,L]